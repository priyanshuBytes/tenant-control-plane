# Copy to .env and fill in. Never commit .env.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# Optional: point at any SQS-compatible endpoint (e.g. ElasticMQ/LocalStack).
# Leave empty to use real AWS SQS.
SQS_ENDPOINT_URL=

# Optional overrides (defaults shown)
TASKS_QUEUE_NAME=tenant-tasks
UPDATES_QUEUE_NAME=tenant-task-updates
